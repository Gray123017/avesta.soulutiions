# Data files must never be served over the web.
#
# Named individually rather than blocking *.json: manifest.json has to be
# readable or the app cannot be installed on a phone, and a blanket rule
# silently returns 403 for it. Anything new that stores data goes on this list
# AND in av_backup_allowlist(); tests/backup.test.mjs fails the build if a
# store appears in one and not the other.
<FilesMatch "^(records_data|users|enquiries|rates_cache|it_questions|login_attempts|enquiry_rate|ithelp_rate|password_resets|email_recovery|employers|remittances|notify|assistant_rate)\.(json|jsonl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Applicant documents: see documents/.htaccess, which api.php writes and
# re-checks on every request. The rule cannot live here — Apache refuses
# <Directory> inside .htaccess, and "php_flag" fails on PHP-FPM hosts; either
# one turns every page on the site into "500 Internal Server Error".


# Archive formats, as a precaution rather than a rule about anything that
# exists today. A downloaded backup holds every NRC scan and password hash on
# the server; one copied into public_html by mistake would be the worst leak
# this site is capable of, so the web server refuses them outright. The .zip,
# .rar and .exe installers under /downloads/ are deliberately not on this list.
<FilesMatch "\.(jsonl|lock|tmp|tar|tgz|gz|bak|sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Internal documentation is deployed with the repo root but must not be public.
# All Markdown files are blocked (the site serves none). Text files are named
# individually because robots.txt has to stay readable.
<FilesMatch "\.md$|^DEPLOY_TO_HOSTINGER\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Repository and tooling files ship with the root but are not part of the site.
# .gitignore is the one that matters: it names every data file on the server,
# which is a map for anyone probing. manifest.json is matched later and must
# stay readable, so package*.json is named exactly rather than by extension.
<FilesMatch "^\.(gitignore|gitattributes|editorconfig|prettierrc|prettierignore|user\.ini)$|^package(-lock)?\.json$|^(bun\.lock|composer\.(json|lock)|tsconfig\.json|eslint\.config\.(js|mjs|cjs)|vite\.config\.(js|ts)|vitest\.config\.(js|ts))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Build and CI directories. These deploy because the repo root is the document
# root; nothing in them is ever requested by a page. 404 rather than 403 so the
# response does not confirm the path exists.
RedirectMatch 404 ^/(scripts|\.github|tests)(/|$)

# Compression. Pages are ~373 KB of text and compress to ~92 KB — the single
# biggest thing you can do for someone on a mobile bundle.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
                                application/javascript application/json \
                                application/manifest+json image/svg+xml
</IfModule>

# The manifest and the service worker need the right types to work at all,
# and the worker must not be cached or updates never reach installed phones.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<FilesMatch "^(manifest\.json|sw\.js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>

# Icons and images rarely change; let phones keep them.
<FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000"
  </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# ── PHP limits ────────────────────────────────────────────────────────────────
# An application carries the NRC, collateral photos and payslips in one
# request. Hosts often default to 8 MB for the WHOLE request, and above that
# PHP silently throws the submission away. .user.ini raises it on PHP-FPM hosts;
# these lines do the same where PHP runs inside Apache. Each block only applies
# if that module is present, so neither can break the other kind of host.
<IfModule mod_php.c>
  php_value post_max_size 25M
  php_value upload_max_filesize 20M
  php_value memory_limit 256M
  php_value max_execution_time 60
</IfModule>
<IfModule mod_php7.c>
  php_value post_max_size 25M
  php_value upload_max_filesize 20M
  php_value memory_limit 256M
  php_value max_execution_time 60
</IfModule>

<Files "avesta-secrets.php">
  Require all denied
</Files>
